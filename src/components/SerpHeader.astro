---
import Icons from './Icons.astro';
import SearchBox from './SearchBox.astro';
import Wordmark from './Wordmark.astro';
import { SITE } from '../consts';
import { url } from '../lib/url';

interface Props { q?: string; tab?: string; tabs?: { label: string; href: string }[]; }
const { q = '', tab = '전체', tabs = [] } = Astro.props;
const all = [{ label: '전체', href: url('/search') }, ...tabs];
---
<header class="serp-head">
  <div class="serp-head__in">
    <a class="serp-logo" href={url('/')} aria-label={SITE.title}><Wordmark /></a>
    <SearchBox value={q} />
    <div class="serp-actions">
      <button class="iconbtn" type="button" aria-label="앱" title="장식"><Icons name="apps" size={24} /></button>
      <a class="signin" href={SITE.github}>로그인</a>
    </div>
  </div>
  <nav class="serp-tabs">
    {all.map((t) => (
      <a href={t.href} aria-current={t.label === tab ? 'page' : undefined}>{t.label}</a>
    ))}
  </nav>
</header>
