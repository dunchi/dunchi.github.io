---
import TopBar from './TopBar.astro';
import { url } from '../lib/url';

interface Props { q?: string; tab?: string; tabs?: { label: string; href: string }[]; }
const { q = '', tab = '전체', tabs = [] } = Astro.props;
const all = [{ label: '전체', href: url('/') }, ...tabs];
---
<header class="serp-head">
  <TopBar search q={q} />
  <nav class="serp-tabs">
    {all.map((t) => (
      <a href={t.href} aria-current={t.label === tab ? 'page' : undefined}>{t.label}</a>
    ))}
  </nav>
</header>
