---
import { SITE } from '../consts';
const ITEMS = [
  {
    c: 'b',
    h: '수집하는 것 — 없음',
    p: '로그인도 댓글도 추적 스크립트도 없습니다. 넣을 수 있는데 <b>안 넣었습니다.</b> 남의 방문 기록으로 할 일이 없어서요.',
  },
  {
    c: 'r',
    h: '브라우저에 남는 것 — 딱 하나',
    p: '밝은 테마냐 어두운 테마냐. 그거 하나입니다. 이 브라우저 밖으로 <b>한 발짝도</b> 안 나갑니다.',
  },
  {
    c: 'y',
    h: '메일 보내기',
    p: '작성한 내용은 이 사이트를 거치지 않고 <b>당신 메일 앱으로 바로</b> 갑니다. 중간에 서버를 하나 세워두면 다 들여다볼 수 있는데, <b>안 세웠습니다.</b>',
  },
  {
    c: 'g',
    h: '호스팅 — GitHub Pages',
    p: '접속 기록은 GitHub 몫입니다. 이건 안 보는 게 아니라 <b>정말 못 봅니다.</b> 저한테 안 주거든요.',
  },
];
---
<div class="mdlg" hidden data-info-dlg>
  <div class="mdlg__card is-info" role="dialog" aria-labelledby="info-t" aria-modal="true">
    <h2 class="info__title" id="info-t">개인정보처리방침</h2>

    <div class="info__scroll">
      <p class="info__lead">
        개인이 취미로 만든 <b>정적 사이트</b>입니다.
        마음먹으면 서버를 붙여서 뭐든 수집할 수 있습니다. <b>안 붙였습니다.</b>
      </p>

      {ITEMS.map((i) => (
        <div class={`info__row is-${i.c}`}>
          <span class="info__dot"></span>
          <div>
            <div class="info__h">{i.h}</div>
            <p class="info__p" set:html={i.p}></p>
          </div>
        </div>
      ))}

      <p class="info__note">
        요약하면 <b>"못 한다"가 아니라 "안 한다"</b>입니다.
        그 편이 더 믿을 만한 말이라고 생각해서 그렇게 적었습니다.
      </p>

      <div class="info__take">
        <div class="info__h">가져가도 됩니다</div>
        <p class="info__p">
          디자인이든 코드든 쓸모 있어 보이면 마음껏 쓰세요.
          출처를 남겨주시면 제가 기분이 좋습니다. 의무는 아닙니다.
        </p>
      </div>

      <p class="info__foot">
        구글 검색 화면에서 영감을 받았을 뿐, Google LLC와는 아무 사이도 아닙니다.
        저쪽은 저를 모릅니다. 문의는 <b>{SITE.email}</b>
      </p>
    </div>

    <div class="mdlg__acts">
      <button type="button" class="mdlg__btn" data-info-close>알겠습니다</button>
    </div>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-info-dlg]');
  const show = (on: boolean) => { if (box) box.hidden = !on; };

  document.querySelectorAll('[data-info-open]').forEach((b) =>
    b.addEventListener('click', (e) => { e.preventDefault(); show(true); })
  );
  box?.querySelector('[data-info-close]')?.addEventListener('click', () => show(false));
  box?.addEventListener('click', (e) => { if (e.target === box) show(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box && !box.hidden) show(false);
  });
</script>
