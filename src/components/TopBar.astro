---
import Icons from './Icons.astro';
import AccountButton from './AccountButton.astro';
import { SITE } from '../consts';
import { url } from '../lib/url';
---
<header class="topbar">
  <nav class="topbar__left">
    <a href={url('/about')}>{SITE.title} 정보</a>
    <a href={url('/archive')}>스토어</a>
  </nav>
  <nav class="topbar__right">
    <a href={`mailto:${SITE.email}`} data-mail-open>메일</a>
    <a href={url('/archive')}>이미지</a>
    <button class="iconbtn" type="button" aria-label="앱" title="앱 (장식)"><Icons name="apps" size={24} /></button>
    <AccountButton />
  </nav>
</header>
