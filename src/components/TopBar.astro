---
import Icons from './Icons.astro';
import AccountButton from './AccountButton.astro';
import Wordmark from './Wordmark.astro';
import { SITE } from '../consts';
import SearchBox from './SearchBox.astro';
import { url } from '../lib/url';

interface Props { q?: string; search?: boolean; }
const { q = '', search = false } = Astro.props;
---
<header class:list={['topbar', search && 'topbar--serp']}>
  <nav class="topbar__left">
    {search && (
      <button class="iconbtn topbar__burger" type="button" aria-label="탐색 메뉴" aria-expanded="true" data-sb-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 5H4a1 1 0 000 2h16a1 1 0 100-2Zm0 6H4a1 1 0 000 2h16a1 1 0 000-2Zm0 6H4a1 1 0 000 2h16a1 1 0 000-2Z"/>
        </svg>
      </button>
    )}
    {search && <a class="topbar__logo" href={url('/')} aria-label={`${SITE.title} 홈페이지로 이동`}><Wordmark /></a>}
  </nav>
  {search && <SearchBox value={q} />}
  <nav class="topbar__right">
    <a href={`mailto:${SITE.email}`} data-mail-open>메일</a>
    <a href={url('/archive')}>이미지</a>
    <button class="iconbtn" type="button" aria-label="공유" title="공유">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M16 5l-1.42 1.42-1.59-1.59V16h-1.98V4.83L9.42 6.42 8 5l4-4 4 4zm4 5v11c0 1.1-.9 2-2 2H6c-1.11 0-2-.9-2-2V10c0-1.11.89-2 2-2h3v2H6v11h12V10h-3V8h3c1.1 0 2 .89 2 2z"/>
      </svg>
    </button>
    <button class="iconbtn" type="button" aria-label="앱" title="앱 (장식)"><Icons name="apps" size={24} /></button>
    <AccountButton />
  </nav>
</header>

<script>
  /* 사이드바 접기. 유튜브처럼 상태를 기억한다. */
  const KEY = 'sb-off';
  const apply = (off: boolean) => {
    document.body.classList.toggle('sb-off', off);
    document.querySelector('[data-sb-toggle]')?.setAttribute('aria-expanded', String(!off));
  };
  try { apply(localStorage.getItem(KEY) === '1'); } catch {}
  document.querySelector('[data-sb-toggle]')?.addEventListener('click', () => {
    const off = !document.body.classList.contains('sb-off');
    apply(off);
    try { localStorage.setItem(KEY, off ? '1' : '0'); } catch {}
  });
</script>
