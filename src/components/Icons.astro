---
interface Props { name: 'search' | 'mic' | 'lens' | 'apps'; size?: number; }
const { name, size = 24 } = Astro.props;
---

{name === 'search' && (
  <svg class="ico-search" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
  </svg>
)}

{name === 'mic' && (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <path fill="#4285f4" d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"/>
    <path fill="none" stroke="#fbbc05" stroke-width="2" stroke-linecap="round" d="M6 11a6 6 0 0 0 6 6"/>
    <path fill="none" stroke="#ea4335" stroke-width="2" stroke-linecap="round" d="M18 11a6 6 0 0 1-6 6"/>
    <path fill="none" stroke="#34a853" stroke-width="2" stroke-linecap="round" d="M12 17v4"/>
  </svg>
)}

{name === 'lens' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path stroke="#4285f4" stroke-width="2" stroke-linecap="round" d="M3 8V5a2 2 0 0 1 2-2h3"/>
    <path stroke="#ea4335" stroke-width="2" stroke-linecap="round" d="M16 3h3a2 2 0 0 1 2 2v3"/>
    <path stroke="#fbbc05" stroke-width="2" stroke-linecap="round" d="M21 16v3a2 2 0 0 1-2 2h-3"/>
    <path stroke="#34a853" stroke-width="2" stroke-linecap="round" d="M8 21H5a2 2 0 0 1-2-2v-3"/>
    <circle cx="12" cy="12" r="3.2" fill="#4285f4"/>
  </svg>
)}

{name === 'apps' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="#5f6368" aria-hidden="true">
    <circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/>
    <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
    <circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
  </svg>
)}
