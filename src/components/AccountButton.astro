---
import { SITE } from '../consts';
import { url } from '../lib/url';
/* 구글 계정 버튼 실측: 래퍼 40x40(padding 4px, radius 50%), 안쪽 이미지 32x32 원형.
   사진을 쓰려면 public/avatar.jpg 를 두고 아래 .avatar__img 를 <img>로 바꾸면 된다. */
---
<div class="account">
  <button
    class="account__btn"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label={`${SITE.author} 프로필`}
    data-acct-btn
  >
    <span class="account__img">{SITE.author[0]}</span>
  </button>

  <div class="account__card" role="dialog" aria-label="프로필" hidden data-acct-card>
    <button class="account__close" type="button" aria-label="닫기" data-acct-close>✕</button>
    <div class="account__handle">{SITE.github.replace('https://', '')}</div>
    <span class="account__big">{SITE.author[0]}</span>
    <div class="account__hi">안녕하세요, {SITE.author}님</div>
    <a class="account__pill" href={url('/about')}>프로필 보기</a>
    <div class="account__sep"></div>
    <a class="account__row" href={SITE.github}>GitHub</a>
    <a class="account__row" href={url('/rss.xml')}>RSS 구독</a>
    <div class="account__sep"></div>
    <div class="account__foot">
      <a href={url('/about')}>블로그 정보</a>
      <span>·</span>
      <a href={url('/archive')}>아카이브</a>
    </div>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-acct-btn]');
  const card = document.querySelector<HTMLElement>('[data-acct-card]');
  const close = document.querySelector<HTMLButtonElement>('[data-acct-close]');

  const open = (on: boolean) => {
    if (!card || !btn) return;
    card.hidden = !on;
    btn.setAttribute('aria-expanded', String(on));
  };

  btn?.addEventListener('click', (e) => { e.stopPropagation(); open(card?.hidden ?? true); });
  close?.addEventListener('click', () => open(false));
  document.addEventListener('click', (e) => {
    if (card && !card.hidden && !card.contains(e.target as Node)) open(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
</script>
