---
import { SITE, LINKS } from '../consts';
import { url } from '../lib/url';
import Icons from './Icons.astro';
/* 구글 실측:
   - 래퍼 40x40, padding 4px, radius 50%
   - 안쪽 이미지 32x32 원형
   - 40x40 SVG 링 4조각 (#F6AD01 #249A41 #3174F1 #E92D18) */
const RING = [
  { fill: '#F6AD01', d: 'M4.02,28.27C2.73,25.8,2,22.98,2,20c0-2.87,0.68-5.59,1.88-8l-1.72-1.04C0.78,13.67,0,16.75,0,20c0,3.31,0.8,6.43,2.23,9.18L4.02,28.27z' },
  { fill: '#249A41', d: 'M32.15,33.27C28.95,36.21,24.68,38,20,38c-6.95,0-12.98-3.95-15.99-9.73l-1.79,0.91C5.55,35.61,12.26,40,20,40c5.2,0,9.93-1.98,13.48-5.23L32.15,33.27z' },
  { fill: '#3174F1', d: 'M33.49,34.77C37.49,31.12,40,25.85,40,20c0-5.86-2.52-11.13-6.54-14.79l-1.37,1.46C35.72,9.97,38,14.72,38,20c0,5.25-2.26,9.98-5.85,13.27L33.49,34.77z' },
  { fill: '#E92D18', d: 'M20,2c4.65,0,8.89,1.77,12.09,4.67l1.37-1.46C29.91,1.97,25.19,0,20,0l0,0C12.21,0,5.46,4.46,2.16,10.96L3.88,12C6.83,6.08,12.95,2,20,2' },
];
const avatar = url('/avatar.jpg');
const photo = url('/profile.jpg');
---
<div class="account">
  <button
    class="account__btn"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label={`${SITE.author} 프로필`}
    data-acct-btn
  >
    <svg class="account__ring" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
      {RING.map((p) => <path fill={p.fill} d={p.d} />)}
    </svg>
    <img class="account__img" src={avatar} alt="" width="32" height="32" />
  </button>

  <div class="account__card" role="dialog" aria-label="프로필" hidden data-acct-card>
    <button class="account__close" type="button" aria-label="닫기" data-acct-close>✕</button>
    <div class="account__handle">{SITE.email}</div>
    <button class="account__bigbtn" type="button" aria-label="사진 크게 보기" data-photo-open>
      <img class="account__big" src={avatar} alt="" width="80" height="80" />
    </button>
    <div class="account__hi">안녕하세요, {SITE.author}입니다.</div>
    <a class="account__pill" href={url('/about')}>프로필 보기</a>
    <div class="account__sep"></div>
    {LINKS.map((l) => (
      <a class="account__row" href={l.href} target="_blank" rel="noopener">
        <span class="account__rowico"><Icons name={l.icon} size={20} /></span>
        <span>{l.label}</span>
      </a>
    ))}
    <a class="account__row" href={url('/rss.xml')}>
      <span class="account__rowico"><Icons name="ai" size={20} /></span>
      <span>RSS 구독</span>
    </a>
    <div class="account__sep"></div>
    <div class="account__foot">
      <a href={url('/about')}>블로그 정보</a>
      <span>·</span>
      <a href={url('/archive')}>아카이브</a>
    </div>
  </div>
</div>

<div class="lightbox" hidden data-photo-box>
  <button class="lightbox__close" type="button" aria-label="닫기" data-photo-close>✕</button>
  <img src={photo} alt={`${SITE.author} 프로필 사진`} />
</div>

<script>
  const acctBtn = document.querySelector<HTMLButtonElement>('[data-acct-btn]');
  const acctCard = document.querySelector<HTMLElement>('[data-acct-card]');
  const acctClose = document.querySelector<HTMLButtonElement>('[data-acct-close]');
  const photoBox = document.querySelector<HTMLElement>('[data-photo-box]');

  const openAcct = (on: boolean) => {
    if (!acctCard || !acctBtn) return;
    acctCard.hidden = !on;
    acctBtn.setAttribute('aria-expanded', String(on));
  };
  const openPhoto = (on: boolean) => {
    if (photoBox) photoBox.hidden = !on;
  };

  acctBtn?.addEventListener('click', (e) => { e.stopPropagation(); openAcct(acctCard?.hidden ?? true); });
  acctClose?.addEventListener('click', () => openAcct(false));

  // 카드 안 사진을 누르면 원본을 띄운다
  document.querySelector('[data-photo-open]')?.addEventListener('click', (e) => {
    e.stopPropagation();
    openPhoto(true);
  });
  document.querySelector('[data-photo-close]')?.addEventListener('click', (e) => {
    e.stopPropagation();
    openPhoto(false);
  });
  photoBox?.addEventListener('click', () => openPhoto(false));

  document.addEventListener('click', (e) => {
    if (photoBox && !photoBox.hidden) return;          // 원본 보는 중엔 카드를 건드리지 않는다
    if (acctCard && !acctCard.hidden && !acctCard.contains(e.target as Node)) openAcct(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (photoBox && !photoBox.hidden) { openPhoto(false); return; }
    openAcct(false);
  });
</script>
