---
import { SITE } from '../consts';
import I from './MailIcons.astro';
/* Gmail 작성창 CDP 실측 (작성창 600x616 기준 좌표)
   헤더    40px  bg #f2f6fc  radius 8 8 0 0   버튼 24x24 @508/536/564
   툴바    x16 y512  565x40  bg #f2f6fc  radius 24px  padding 10px 9px
           구분선 1x20 #c4c7c5
   액션바  보내기 x16 72x36 radius 18/0/0/18  ▾ x88 33x36 radius 0/18/18/0  #0b57d0
           아이콘 20x20 radius 2px, x=133부터 32px 간격, 삭제 x564 */
const TOOLS = [
  { n: 'undo', l: '실행취소' },
  { n: 'redo', l: '재실행' },
  '|',
  { n: 'font', l: '글꼴', text: 'Sans Serif', w: 97 },
  '|',
  { n: 'size', l: '크기', icon: 'aa', w: 40, caret: true },
  '|',
  { n: 'bold', l: '굵게' },
  { n: 'italic', l: '기울임꼴' },
  { n: 'underline', l: '밑줄' },
  { n: 'textcolor', l: '텍스트 색상', w: 40, caret: true },
  '|',
  { n: 'align', l: '정렬', w: 40, caret: true },
  { n: 'numlist', l: '번호 매기기 목록' },
  { n: 'bullist', l: '글머리 기호 목록' },
  { n: 'outdent', l: '덜 들여쓰기' },
  { n: 'indent', l: '더 들여쓰기' },
  '|',
  { n: 'more', l: '서식 지정 옵션 더보기', icon: 'caret' },
] as const;

const ACTIONS = [
  { n: 'format', icon: 'aa', l: '서식 지정 옵션' },
  { n: 'attach', icon: 'attach', l: '파일 첨부' },
  { n: 'link', icon: 'link', l: '링크 삽입' },
] as const;
---
<div class="compose no-tools" hidden data-mail>
  <div class="compose__head">
    <span class="compose__title">새 메일</span>
    <div class="compose__acts">
      <button type="button" aria-label="최소화" data-mail-min><I name="minimize" size={20} /></button>
      <button type="button" aria-label="저장 및 닫기" data-mail-close><I name="close" size={20} /></button>
    </div>
  </div>

  <div class="compose__body">
    <label class="compose__field">
      <span>발신</span>
      <input type="text" data-mail-from />
    </label>
    <label class="compose__field">
      <span>수신</span>
      <input type="text" value={SITE.email} readonly />
    </label>
    <label class="compose__field">
      <input type="text" placeholder="제목" data-mail-subject />
    </label>
    <div class="compose__text" contenteditable="true" data-mail-text data-ph="메일 본문"></div>
  </div>

  <div class="compose__tools" data-mail-tools>
    {TOOLS.map((t) =>
      t === '|' ? (
        <span class="compose__sep"></span>
      ) : (
        <button
          type="button"
          class:list={['compose__tool', t.w ? 'is-wide' : '']}
          style={t.w ? `width:${t.w}px` : undefined}
          data-cmd={t.n}
          aria-label={t.l}
          title={t.l}
        >
          {'text' in t && t.text ? <span class="compose__ttext">{t.text}</span> : null}
          {!('text' in t && t.text) && <I name={'icon' in t && t.icon ? t.icon : t.n} size={20} />}
          {'caret' in t && t.caret ? <I name="caret" size={16} /> : null}
          {'text' in t && t.text ? <I name="caret" size={16} /> : null}
        </button>
      )
    )}
  </div>

  <div class="compose__foot">
    <div class="compose__send">
      <button type="button" class="compose__send-main" data-mail-send>보내기</button>
    </div>
    {ACTIONS.map((a) => (
      <button type="button" class="compose__act" data-act={a.n} aria-label={a.l} title={a.l}>
        {a.n === 'format' ? <span class="compose__aa">Aa</span> : <I name={a.icon} size={20} />}
      </button>
    ))}
  </div>
</div>

<div class="mdlg" hidden data-mail-confirm>
  <div class="mdlg__card" role="alertdialog" aria-labelledby="mdlg-t" aria-describedby="mdlg-b">
    <h2 class="mdlg__title" id="mdlg-t">작성 중인 내용이 있습니다</h2>
    <p class="mdlg__body" id="mdlg-b">지금 닫으면 저장되지 않습니다.</p>
    <div class="mdlg__acts">
      <button type="button" class="mdlg__btn" data-mail-keep>계속 작성</button>
      <button type="button" class="mdlg__btn is-danger" data-mail-discard>닫기</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ to: SITE.email }}>
  (function () {
    const panel = document.querySelector('[data-mail]');
    if (!panel) return;
    const subject = panel.querySelector('[data-mail-subject]');
    const text = panel.querySelector('[data-mail-text]');
    const tools = panel.querySelector('[data-mail-tools]');

    const open = (on) => {
      panel.hidden = !on;
      if (on) { panel.classList.remove('is-min'); subject?.focus(); }
    };

    // 본문(contenteditable)에 포커스가 있을 때 버튼을 누르면
    // mousedown 이 먼저 blur 를 일으켜 click 이 유실된다.
    // 버튼 위에서는 기본 포커스 이동을 막아 첫 클릭이 그대로 먹히게 한다.
    panel.addEventListener('mousedown', (e) => {
      if (e.target.closest('button')) e.preventDefault();
    });
    document.querySelectorAll('[data-mail-open]').forEach((b) =>
      b.addEventListener('click', (e) => { e.preventDefault(); open(true); })
    );
    const confirmBox = document.querySelector('[data-mail-confirm]');
    const hasContent = () =>
      !!(panel.querySelector('[data-mail-from]')?.value.trim() ||
         subject?.value.trim() ||
         text?.innerText.trim());
    const wipe = () => {
      const f = panel.querySelector('[data-mail-from]');
      if (f) f.value = '';
      if (subject) subject.value = '';
      if (text) { text.innerHTML = ''; text.classList.add('is-empty'); }
    };
    const tryClose = () => {
      if (hasContent()) { confirmBox.hidden = false; return; }
      open(false);
    };
    panel.querySelector('[data-mail-close]')?.addEventListener('click', tryClose);
    confirmBox?.querySelector('[data-mail-keep]')?.addEventListener('click', () => {
      confirmBox.hidden = true;
      text?.focus();
    });
    confirmBox?.querySelector('[data-mail-discard]')?.addEventListener('click', () => {
      confirmBox.hidden = true;
      wipe();
      open(false);
    });
    confirmBox?.addEventListener('click', (e) => {
      if (e.target === confirmBox) confirmBox.hidden = true;
    });
    panel.querySelector('[data-mail-min]')?.addEventListener('click', () => panel.classList.toggle('is-min'));
    panel.querySelector('.compose__head')?.addEventListener('click', (e) => {
      if (e.target.closest('button')) return;
      panel.classList.toggle('is-min');
    });

    // Aa 로 서식 툴바 토글 (Gmail 과 동일)
    const fmt = panel.querySelector('[data-act="format"]');
    fmt?.addEventListener('click', () => {
      panel.classList.toggle('no-tools');
      fmt.classList.toggle('is-on', !panel.classList.contains('no-tools'));
    });


    // 본문 비어 있으면 플레이스홀더
    const sync = () => text.classList.toggle('is-empty', !text.textContent.trim());
    text?.addEventListener('input', sync); sync();

    panel.querySelector('[data-mail-send]')?.addEventListener('click', () => {
      const from = (panel.querySelector('[data-mail-from]')?.value || '').trim();
      const s = encodeURIComponent(subject?.value || '');
      const body = (from ? `회신받을 곳: ${from}\n\n` : '') + (text?.innerText || '');
      const b = encodeURIComponent(body);
      location.href = `mailto:${to}?subject=${s}&body=${b}`;
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (confirmBox && !confirmBox.hidden) { confirmBox.hidden = true; return; }
      if (!panel.hidden) tryClose();
    });
  })();
</script>
