---
import type { GetStaticPaths, Page } from 'astro';
import Shell from '../../layouts/Shell.astro';
import SerpHeader from '../../components/SerpHeader.astro';
import Result from '../../components/Result.astro';
import GPager from '../../components/GPager.astro';
import Footer from '../../components/Footer.astro';
import { getPosts, tagCounts, type Post } from '../../lib/posts';
import { PAGE_SIZE } from '../../consts';
import { url } from '../../lib/url';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
const all = await getPosts();
const tabs = tagCounts(all)
  .slice(0, 5)
  .map((t) => ({ label: t.tag, href: url('/tags/' + encodeURIComponent(t.tag)) }));
const took = (0.18 + Math.random() * 0.24).toFixed(2);
const hrefFor = (p: number) => (p === 1 ? url('/search') : url('/search/' + p));
---

<Shell title="전체">
  <SerpHeader tabs={tabs} />
  <main class="serp">
    <div class="serp-stats" data-stats>검색결과 약 {page.total}개 ({took}초)</div>
    <ol class="results">
      {page.data.map((post) => <Result post={post} />)}
    </ol>
    <GPager current={page.currentPage} last={page.lastPage} hrefFor={hrefFor} />
  </main>
  <Footer />
</Shell>
