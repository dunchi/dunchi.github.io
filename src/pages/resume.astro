---
import Shell from '../layouts/Shell.astro';
import SerpHeader from '../components/SerpHeader.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

const METRICS = [
  { n: '900+', l: '고객 업장' },
  { n: '2,700+', l: '사용자 (업장당 3인 이상)' },
  { n: '25', l: '서버 도메인' },
  { n: '6명', l: '개발팀 (파트장)' },
];

const SKILLS = [
  ['백엔드', 'Java, <b>Spring Boot 3.5</b>, Spring Cloud Config, JPA, REST / OpenAPI'],
  ['프론트엔드', '<b>React 19</b>, <b>TypeScript</b>, Next.js, MUI, TanStack Query'],
  ['모바일', '<b>React Native</b>, Expo, Android · iOS 네이티브 빌드, Fastlane'],
  ['인프라 · 배포', '<b>Docker</b>, <b>Docker Swarm</b> 무중단 배포, <b>GitHub Actions self-hosted runner</b>, VM 운영'],
  ['인증 · 네트워크', '<b>Keycloak</b>(SSO·Realm 운영), <b>NetBird</b> VPN 서버 구축·운영, <b>OPNsense</b> 방화벽'],
  ['데이터', 'MySQL, PostgreSQL, 대용량 쿼리 튜닝, 백업·복구 전략'],
  ['과거 주력', 'C# (.NET, WinForm, WPF), Unity, PHP — 산업·건설 현장 프로그램'],
];

const TOOLS = [
  ['swagger-change-notifier', 'API 스펙 변경 감지·알림'],
  ['spring-config-crypto-editor', 'Spring Cloud Config 암복호화 편집기'],
  ['hurl-ide', 'HTTP 테스트 도구'],
  ['github-issue-browser-app', '이슈 브라우저'],
  ['overtime-report · attendance-reminder', '근태 자동화'],
  ['server-maintenance', '서버 점검 스크립트'],
  ['template-java-web · template-electron', '프로젝트 템플릿'],
  ['mlx-whisper', '로컬 음성 인식'],
];
---

<Shell title="이력서" description={`${SITE.author} 백엔드·인프라 개발자 경력기술서`}>
  <SerpHeader q="김한주 이력서" />

  <main class="cv">
    <article class="cv__inner">
      <header class="cv__head">
        <h1>김한주</h1>
        <p class="cv__role">백엔드 · 인프라 개발자 &nbsp;|&nbsp; 실경력 6년</p>
        <p class="cv__contact">
          {SITE.email} · <a href={SITE.github}>github.com/dunchi</a>
        </p>
      </header>

      <section>
        <h2>요약</h2>
        <ul class="cv__list">
          <li><b>서비스 하나를 서버부터 배포까지 혼자 세울 수 있습니다.</b> Spring Boot 백엔드, Docker Swarm 무중단 배포, CI 러너, 인증 서버, VPN·방화벽까지 직접 구축해 운영 중입니다.</li>
          <li>현재 <b>고객업장 900여 곳</b>이 쓰는 노무·세무·회계 통합 플랫폼에서 <b>개발파트장</b>으로 6인 팀을 이끌고 있습니다.</li>
          <li>백엔드가 주력이지만 <b>React/TypeScript 프론트와 React Native 앱까지</b> 같은 저장소 안에서 함께 다룹니다.</li>
        </ul>
      </section>

      <section>
        <h2>핵심 기술</h2>
        <table class="cv__table">
          {SKILLS.map(([k, v]) => (
            <tr><th>{k}</th><td set:html={v}></td></tr>
          ))}
        </table>
      </section>

      <section>
        <h2>경력</h2>

        <div class="cv__co">
          <span class="cv__co-name">나이스노무법인</span>
          <span class="cv__co-when">2025.03 ~ 재직 중 · <b>개발파트장</b></span>
        </div>
        <p class="cv__co-desc">노무사·세무사·회계사의 업무를 하나로 묶는 B2B SaaS 플랫폼. 백엔드·인프라 총괄.</p>

        <div class="cv__metrics">
          {METRICS.map((m) => (
            <div><span class="n">{m.n}</span><span class="l">{m.l}</span></div>
          ))}
        </div>

        <h3>직접 설계·구축한 것</h3>
        <ul class="cv__list cv__owned">
          <li><b>배포 체계 전반</b> — Docker Swarm 기반 무중단 배포 파이프라인을 처음부터 설계. 헬스체크·기동 순서·종료 유예까지 잡아 배포 중 단절을 제거했습니다.</li>
          <li><b>CI 인프라</b> — GitHub Actions <b>self-hosted runner</b> 도입·운영. 러너 디스크 관리와 VM 스펙 산정까지 포함합니다.</li>
          <li><b>인증 서버</b> — <b>Keycloak</b> 도입, Realm 구성과 설정 형상관리 체계 수립. 여러 서비스가 SSO로 붙습니다.</li>
          <li><b>사내망 · 보안</b> — <b>NetBird</b>(WireGuard 기반) VPN 서버 구축, 그룹·정책·라우트 설계로 스테이지 망 접근을 통제. <b>OPNsense</b> 방화벽 운영.</li>
          <li><b>설정 관리</b> — Spring Cloud Config 암복호화 자동화 도구를 직접 만들어 운영 설정의 평문 노출을 없앴습니다.</li>
          <li><b>API 자동화</b> — OpenAPI 스펙에서 프론트 타입·API 액션을 자동 생성하는 파이프라인 구축. 백엔드 변경이 프론트에 수작업 없이 반영됩니다.</li>
        </ul>

        <h3>도메인 설계 및 개발</h3>
        <ul class="cv__list">
          <li>급여·세무·4대보험·근태·전자결재·계약·문서·알림·OCR 등 <b>25개 서버 도메인</b>을 도메인별 서비스로 분리해 설계했습니다.</li>
          <li>BFF·Gateway 계층을 두어 클라이언트 13종(웹·모바일·관리자)이 동일한 백엔드를 각자 필요한 형태로 소비하도록 구성했습니다.</li>
          <li>대용량 정산 처리를 위해 <b>CQRS·Saga·Transactional Outbox</b> 패턴을 프로토타입으로 검증했습니다.</li>
        </ul>

        <h3>참여</h3>
        <ul class="cv__list">
          <li><b>프론트엔드</b> — React 19 / TypeScript / Next.js. 전담 팀원이 주도하고 저는 서브로 참여하며 공통 컴포넌트와 API 연동을 맡았습니다.</li>
          <li><b>모바일 앱</b> — React Native 기반 사내 협업 앱. Android·iOS 네이티브 빌드와 Fastlane 배포 파이프라인을 다룹니다.</li>
          <li><b>팀 운영</b> — 6인 개발팀의 파트장으로 일정·코드리뷰·기술 결정을 맡고 있습니다.</li>
        </ul>

        <div class="cv__co">
          <span class="cv__co-name">센스토어</span>
          <span class="cv__co-when">2023.04 ~ 2024.11 · 20개월</span>
        </div>
        <p class="cv__co-desc">C# 응용프로그램 · PHP 웹 풀스택(단독) · Android 환경 대응</p>
        <ul class="cv__list">
          <li><b>대용량 정보 제공 웹 서비스</b>를 기획·DB 설계·백엔드·프론트까지 <b>단독</b>으로 개발했습니다. (PHP / MySQL / JS)</li>
          <li>반복 업무 자동화 도구 개발 — C# 데스크탑 툴, 웹 스크래핑 기반 데이터 수집·가공.</li>
          <li>PC 한 대에 다수 Android 단말을 연결한 <b>네트워크 제어 환경</b> 구축. 단말별 IP 전환과 트래픽 관리 로직 구현.</li>
          <li>네이버 출신 시니어 개발자와 협업하며 코드 품질 기준을 습득했고, WinForm의 한계를 넘기 위해 WPF·Web으로 스택을 확장했습니다.</li>
        </ul>

        <div class="cv__co">
          <span class="cv__co-name">(주)고려소프트웨어</span>
          <span class="cv__co-when">2022.06 ~ 2022.09 · 3개월</span>
        </div>
        <p class="cv__co-desc">Unity 기반 3D 시뮬레이션</p>
        <ul class="cv__list">
          <li>드론 촬영 데이터로 실제 공사현장을 3D로 재현하는 <b>디지털 트윈</b> 시뮬레이터 개발. 자재·인원·건물 배치 시뮬레이션 기능 구현.</li>
          <li>정부기관 관계자 대상 시연을 직접 수행했습니다.</li>
        </ul>

        <div class="cv__co">
          <span class="cv__co-name">주식회사 이엔지소프트</span>
          <span class="cv__co-when">2017.11 ~ 2020.08 · 33개월</span>
        </div>
        <p class="cv__co-desc">C# Windows 응용프로그램 · Java 웹 풀스택 · 프로젝트 리딩</p>
        <ul class="cv__list">
          <li><b>설계도면 자동화 솔루션(ESDI)</b> — 현대·포스코 등 대형 건설사 공사현장에 실제 도입. 일본·중국 수출에 기여했습니다.</li>
          <li><b>공사현장 CCTV·GPS 인부 위치추적 시스템</b> — 소켓 통신 기반 실시간 처리. <b>2년간 24시간 무중단 운영</b>으로 안정성을 검증했습니다. 프로젝트 리드로 후임 1인을 관리·멘토링했습니다.</li>
          <li>정부 재난 시뮬레이션 웹 시스템 (Java / Spring) — 복잡한 시나리오 로직 설계, 공공 프로젝트의 엄격한 요구사항 대응.</li>
          <li>고경력 DBA와 협업하며 대용량 쿼리 튜닝, 백업·복구 전략을 익혔습니다.</li>
        </ul>
      </section>

      <section>
        <h2>개인 프로젝트 · 도구</h2>
        <p class="cv__note">불편을 느끼면 도구를 만들어 해결합니다. 아래는 실제로 만들어 쓰고 있는 것들입니다.</p>
        <table class="cv__table cv__tools">
          {TOOLS.map(([n, d]) => (
            <tr><th><a href={`${SITE.github}/${n.split(' ·')[0]}`}>{n}</a></th><td>{d}</td></tr>
          ))}
        </table>
      </section>

      <section>
        <h2>학력 및 자격</h2>
        <table class="cv__table">
          <tr><th>학력</th><td>국립 울산에너지고등학교 신재생에너지과 — 전기·자동화·산업안전 중심 기술 교육</td></tr>
          <tr><th>자격</th><td>위험물산업기능사 · 전기기능사 · 생산자동화기능사</td></tr>
        </table>
      </section>

      <div class="cv__print">
        <button type="button" data-cv-print>PDF로 저장 / 인쇄</button>
      </div>
    </article>
  </main>

  <Footer />
</Shell>

<script>
  document.querySelector('[data-cv-print]')?.addEventListener('click', () => window.print());
</script>
