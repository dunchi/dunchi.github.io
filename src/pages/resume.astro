---
import { SITE } from '../consts';
import { url } from '../lib/url';

/* 블로그 껍데기를 쓰지 않는 독립 문서.
   화면으로 훑기 좋고 그대로 인쇄하면 A4 PDF 가 나오도록 만들었다.

   본문은 전부 완료형으로 썼다. 재직 여부는 아래 NICE_PERIOD 한 줄에만 들어 있어서,
   퇴사해도 그 줄만 날짜로 바꾸면 문서 전체가 그대로 유효하다. */

const NICE_PERIOD = '2025.03 ~ 재직 중';

const METRICS = [
  ['900+', '고객 업장'],
  ['2,700+', '사용자'],
  ['25', '서버 도메인'],
  ['6명', '개발팀 (파트장)'],
];

/* 훑는 사람이 붙잡을 수 있게 [라벨 | 한 줄] 로만 쓴다 */
const BUILT = [
  ['배포 체계', 'Docker Swarm 무중단 배포 파이프라인을 처음부터 설계 — 헬스체크·기동 순서·종료 유예까지 잡아 <b>배포 중 단절 제거</b>'],
  ['CI 인프라', 'GitHub Actions <b>self-hosted runner</b> 도입·운영. 러너 디스크 관리와 VM 스펙 산정 포함'],
  ['인증 서버', '<b>Keycloak</b> 도입 — Realm 구성과 설정 형상관리 체계 수립. 다수 서비스가 SSO 로 연결'],
  ['사내망 · 보안', '<b>NetBird</b> VPN 서버 구축 + <b>OPNsense</b> 방화벽 — 그룹·정책·라우트 설계로 스테이지 망 접근 통제'],
  ['설정 관리', 'Spring Cloud Config <b>암복호화 도구를 직접 제작</b> — 운영 설정의 평문 노출 제거'],
  ['API 자동화', 'OpenAPI 스펙 → 프론트 타입·액션 <b>자동 생성 파이프라인</b> — 백엔드 변경이 수작업 없이 반영'],
];

const DESIGNED = [
  ['도메인 분리', '급여·세무·4대보험·근태·전자결재·계약·문서·알림·OCR 등 <b>25개 서버 도메인</b>'],
  ['계층 구조', 'BFF·Gateway 를 두어 클라이언트 13종(웹·모바일·관리자)이 같은 백엔드를 각자 형태로 소비'],
  ['분산 트랜잭션', '대용량 정산 처리를 위해 <b>Saga 패턴을 직접 구현</b>. CQRS · Transactional Outbox 도 함께 검증'],
];

const JOINED = [
  ['프론트엔드', 'React 19 / TypeScript / Next.js — 전담 팀원 주도, 공통 컴포넌트·API 연동 담당 <span class="q">(서브)</span>'],
  ['모바일 앱', 'React Native 사내 협업 앱 — Android·iOS 네이티브 빌드, Fastlane 배포'],
  ['팀 운영', '6인 개발팀 파트장 — 일정·코드리뷰·기술 결정'],
];

const SKILLS = [
  ['백엔드', 'Java · <b>Spring Boot 3.5</b> · Spring Cloud Config · JPA · REST/OpenAPI'],
  ['프론트엔드', '<b>React 19</b> · <b>TypeScript</b> · Next.js · MUI · TanStack Query'],
  ['모바일', '<b>React Native</b> · Expo · Android/iOS 네이티브 빌드 · Fastlane'],
  ['인프라 · 배포', '<b>Docker</b> · <b>Docker Swarm</b> 무중단 배포 · <b>GitHub Actions self-hosted runner</b> · VM 운영'],
  ['인증 · 네트워크', '<b>Keycloak</b> · <b>NetBird</b> VPN · <b>OPNsense</b> 방화벽'],
  ['데이터', 'MySQL · PostgreSQL · 대용량 쿼리 튜닝 · 백업/복구 전략'],
  ['과거 주력', 'C# (.NET, WinForm, WPF) · Unity · PHP — 산업·건설 현장 프로그램'],
];

const PAST = [
  {
    co: '센스토어', when: '2023.04 ~ 2024.11 · 20개월',
    role: 'C# 응용프로그램 · PHP 웹 풀스택(단독) · Android 환경 대응',
    items: [
      ['단독 개발', '대용량 정보 제공 웹 서비스를 기획·DB 설계·백엔드·프론트까지 <b>혼자</b> (PHP/MySQL/JS)'],
      ['업무 자동화', 'C# 데스크탑 툴 + 웹 스크래핑 기반 데이터 수집·가공'],
      ['네트워크 제어', 'PC 1대에 다수 Android 단말 연결 — 단말별 IP 전환·트래픽 관리 로직 구현'],
    ],
  },
  {
    co: '(주)고려소프트웨어', when: '2022.06 ~ 2022.09 · 3개월',
    role: 'Unity 기반 3D 시뮬레이션',
    items: [
      ['디지털 트윈', '드론 촬영 데이터로 공사현장을 3D 재현 — 자재·인원·건물 배치 시뮬레이션'],
      ['대외 시연', '정부기관 관계자 대상 시연 직접 수행'],
    ],
  },
  {
    co: '주식회사 이엔지소프트', when: '2017.11 ~ 2020.08 · 33개월',
    role: 'C# Windows 응용프로그램 · Java 웹 풀스택 · 프로젝트 리딩',
    items: [
      ['상용 솔루션', '설계도면 자동화(ESDI) — 현대·포스코 등 대형 건설사 현장 도입, <b>일본·중국 수출</b> 기여'],
      ['온디바이스', '공사현장 <b>360도 CCTV 시스템</b> — 시판 카메라에 <b>직접 탑재되는 프로그램</b>을 개발. 소켓 통신 실시간 처리, <b>24시간 무중단</b> 동작'],
      ['리딩', '프로젝트 리드로 후임 1인 관리·멘토링'],
      ['공공 · DB', '정부 재난 시뮬레이션(Java/Spring) · 고경력 DBA 협업으로 대용량 튜닝·백업 전략 습득'],
    ],
  },
];

const TOOLS = [
  ['swagger-change-notifier', 'API 스펙 변경 감지·알림'],
  ['spring-config-crypto-editor', 'Spring Cloud Config 암복호화 편집기'],
  ['hurl-ide', 'HTTP 테스트 도구'],
  ['github-issue-browser-app', 'GitHub 이슈 브라우저'],
  ['overtime-report', '근태·초과근무 집계 자동화'],
  ['server-maintenance', '서버 점검 스크립트'],
  ['template-java-web', 'Java 웹 프로젝트 템플릿'],
  ['mlx-whisper', '로컬 음성 인식'],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>김한주 — 백엔드·인프라 개발자</title>
    <meta name="description" content="김한주 경력기술서. 백엔드·인프라 개발자, 실경력 6년." />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap"
    />
    <style is:global>
      @page { size: A4; margin: 13mm 14mm; }
      * { box-sizing: border-box; }
      html { background: #eceff3; }
      body {
        margin: 0;
        font-family: 'Pretendard', 'Noto Sans KR', -apple-system, 'Apple SD Gothic Neo', sans-serif;
        color: #1f2328;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .sheet {
        max-width: 900px;
        margin: 32px auto 80px;
        background: #fff;
        padding: 52px 56px 60px;
        box-shadow: 0 1px 3px rgba(0,0,0,.08), 0 12px 32px -12px rgba(0,0,0,.18);
      }

      /* ---------- 머리 ---------- */
      .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
             padding-bottom: 18px; border-bottom: 2px solid #1f2328; }
      .top h1 { margin: 0; font-size: 32px; font-weight: 700; letter-spacing: -.03em; line-height: 1.15; }
      .top .role { margin: 5px 0 0; font-size: 14.5px; color: #4a5058; }
      .top .contact { text-align: right; font-size: 12.5px; color: #6a727c; line-height: 1.9; white-space: nowrap; }
      .top .contact a { color: #1a56b8; text-decoration: none; }

      h2 { font-size: 13px; font-weight: 700; letter-spacing: .06em; color: #6a727c;
           margin: 34px 0 12px; text-transform: uppercase; }
      section:first-of-type h2 { margin-top: 28px; }

      /* ---------- 요약 ---------- */
      .lead { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none; }
      .lead li { position: relative; padding-left: 15px; font-size: 14.5px; line-height: 1.72; color: #33383f; }
      .lead li::before { content: ''; position: absolute; left: 0; top: 10px; width: 6px; height: 6px;
                         border-radius: 50%; background: #1a56b8; }
      b { font-weight: 700; color: #1f2328; }

      /* ---------- 라벨 + 한 줄 ---------- */
      .rows { display: grid; grid-template-columns: 118px 1fr; gap: 0; }
      .rows dt { font-size: 13.5px; font-weight: 700; color: #1f2328; padding: 7px 14px 7px 0; }
      .rows dd { margin: 0; font-size: 14px; line-height: 1.6; color: #3c434b; padding: 7px 0;
                 border-top: 1px solid #eceef1; }
      .rows dt { border-top: 1px solid #eceef1; }
      .rows dt:first-of-type, .rows dd:first-of-type { border-top: 0; }
      .q { color: #8b929b; font-size: 12.5px; }

      /* 직접 만든 것 — 이 문서의 주장 */
      .built { background: #f6f9fe; border-left: 3px solid #1a56b8; padding: 6px 18px 10px; }
      .built dt { color: #0f3d8a; }
      .built dd { border-top-color: #dde7f6; }
      .built dt { border-top-color: #dde7f6; }

      .blk { margin-top: 20px; }
      .blk h3 { margin: 0 0 8px; font-size: 13.5px; font-weight: 700; color: #1f2328; }

      /* ---------- 회사 ---------- */
      .co { display: flex; justify-content: space-between; align-items: baseline; gap: 14px;
            flex-wrap: wrap; margin-top: 30px; padding-bottom: 7px; border-bottom: 1px solid #d7dbe0; }
      .co .name { font-size: 18px; font-weight: 700; letter-spacing: -.01em; }
      .co .when { font-size: 12.5px; color: #6a727c; }
      .co-role { margin: 8px 0 0; font-size: 13px; color: #6a727c; }

      /* ---------- 숫자 ---------- */
      .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
                 background: #dfe3e8; border: 1px solid #dfe3e8; margin: 16px 0 6px; }
      .metrics div { background: #fff; padding: 12px 14px; }
      .metrics .n { display: block; font-size: 22px; font-weight: 700; color: #1a56b8; line-height: 1.1; }
      .metrics .l { display: block; font-size: 11.5px; color: #6a727c; margin-top: 3px; }

      /* ---------- 도구 ---------- */
      .tools { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
      .tools .t { display: grid; grid-template-columns: 1fr; padding: 6px 0; border-top: 1px solid #eceef1; }
      .tools .t:nth-child(1), .tools .t:nth-child(2) { border-top: 0; }
      .tools .n { font-size: 13px; font-weight: 500; color: #1a56b8; }
      .tools .d { font-size: 12.5px; color: #6a727c; }

      .foot-note { margin: 12px 0 0; font-size: 12.5px; color: #8b929b; }

      /* ---------- 화면 전용 ---------- */
      .bar { max-width: 900px; margin: 0 auto; padding: 18px 56px 0; display: flex;
             justify-content: space-between; align-items: center; }
      .bar a, .bar button { font-family: inherit; font-size: 13px; color: #4a5058; background: none;
                            border: 1px solid #cfd5db; border-radius: 18px; padding: 7px 16px;
                            cursor: pointer; text-decoration: none; }
      .bar button { color: #1a56b8; border-color: #b9cdec; background: #fff; font-weight: 500; }
      .bar a:hover, .bar button:hover { background: #f2f5f9; }

      @media (max-width: 760px) {
        .sheet { padding: 32px 22px 44px; margin: 0; box-shadow: none; }
        .bar { padding: 14px 22px 0; }
        .rows { grid-template-columns: 1fr; }
        .rows dt { padding-bottom: 0; border-top: 1px solid #eceef1; }
        .rows dd { border-top: 0; padding-top: 2px; }
        .metrics { grid-template-columns: 1fr 1fr; }
        .tools { grid-template-columns: 1fr; }
        .tools .t:nth-child(2) { border-top: 1px solid #eceef1; }
        .top { flex-direction: column; align-items: flex-start; }
        .top .contact { text-align: left; white-space: normal; }
      }

      /* ---------- 인쇄 ---------- */
      @media print {
        html, body { background: #fff; }
        .bar { display: none !important; }
        .sheet { max-width: none; margin: 0; padding: 0; box-shadow: none; }
        h2 { margin-top: 20px; }
        .co, .metrics, .built, .blk { break-inside: avoid; }
        .co { break-after: avoid; }
        .top h1 { font-size: 25pt; }
        body { font-size: 10pt; line-height: 1.55; }
        .lead li, .rows dd { font-size: 9.8pt; }
      }
    </style>
  </head>

  <body>
    <div class="bar">
      <a href={url('/')}>← 블로그로</a>
      <button type="button" data-print>PDF로 저장 · 인쇄</button>
    </div>

    <main class="sheet">
      <header class="top">
        <div>
          <h1>김한주</h1>
          <p class="role">백엔드 · 인프라 개발자 &nbsp;|&nbsp; 실경력 6년</p>
        </div>
        <div class="contact">
          {SITE.email}<br />
          <a href={SITE.github}>github.com/dunchi</a><br />
          <a href="https://dunchi.github.io">dunchi.github.io</a>
        </div>
      </header>

      <section>
        <h2>요약</h2>
        <ul class="lead">
          <li><b>서비스 하나를 서버부터 배포까지 혼자 세울 수 있습니다.</b> Spring Boot 백엔드, Docker Swarm 무중단 배포, CI 러너, 인증 서버, VPN·방화벽까지 직접 구축하고 운영했습니다.</li>
          <li><b>고객업장 900여 곳</b>이 쓰는 노무·세무·회계 통합 플랫폼에서 <b>개발파트장</b>으로 6인 팀의 백엔드·인프라를 총괄했습니다.</li>
          <li>백엔드가 주력이지만 <b>React/TypeScript 프론트와 React Native 앱까지</b> 같은 저장소 안에서 함께 다룹니다.</li>
        </ul>
      </section>

      <section>
        <h2>핵심 기술</h2>
        <dl class="rows">
          {SKILLS.map(([k, v]) => (<><dt>{k}</dt><dd set:html={v}></dd></>))}
        </dl>
      </section>

      <section>
        <h2>경력</h2>

        <div class="co"><span class="name">나이스노무법인</span><span class="when">{NICE_PERIOD} · <b>개발파트장</b></span></div>
        <p class="co-role">노무사·세무사·회계사의 업무를 하나로 묶는 B2B SaaS 플랫폼. 백엔드·인프라 총괄.</p>

        <div class="metrics">
          {METRICS.map(([n, l]) => (<div><span class="n">{n}</span><span class="l">{l}</span></div>))}
        </div>

        <div class="blk">
          <h3>직접 설계·구축</h3>
          <dl class="rows built">
            {BUILT.map(([k, v]) => (<><dt>{k}</dt><dd set:html={v}></dd></>))}
          </dl>
        </div>

        <div class="blk">
          <h3>도메인 설계</h3>
          <dl class="rows">
            {DESIGNED.map(([k, v]) => (<><dt>{k}</dt><dd set:html={v}></dd></>))}
          </dl>
        </div>

        <div class="blk">
          <h3>참여</h3>
          <dl class="rows">
            {JOINED.map(([k, v]) => (<><dt>{k}</dt><dd set:html={v}></dd></>))}
          </dl>
        </div>

        {PAST.map((j) => (
          <>
            <div class="co"><span class="name">{j.co}</span><span class="when">{j.when}</span></div>
            <p class="co-role">{j.role}</p>
            <dl class="rows">
              {j.items.map(([k, v]) => (<><dt>{k}</dt><dd set:html={v}></dd></>))}
            </dl>
          </>
        ))}
      </section>

      <section>
        <h2>개인 프로젝트 · 도구</h2>
        <div class="tools">
          {TOOLS.map(([n, d]) => (
            <div class="t">
              <a class="n" href={`${SITE.github}/${n}`}>{n}</a>
              <span class="d">{d}</span>
            </div>
          ))}
        </div>
        <p class="foot-note">불편을 느끼면 도구를 만들어 해결합니다. 전체 목록은 github.com/dunchi 에 있습니다.</p>
      </section>

      <section>
        <h2>학력 및 자격</h2>
        <dl class="rows">
          <dt>학력</dt><dd>국립 울산에너지고등학교 신재생에너지과 — 전기·자동화·산업안전 중심 기술 교육</dd>
          <dt>자격</dt><dd>위험물산업기능사 · 전기기능사 · 생산자동화기능사</dd>
          <dt>병역</dt><dd>2020.11 ~ 2022.05 복무</dd>
        </dl>
      </section>
    </main>

    <script is:inline>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
